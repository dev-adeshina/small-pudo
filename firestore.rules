rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function hasActiveAdminAccess() {
      return exists(
      /databases/$(database)/documents/adminAccess/$(request.auth.uid)
      )
        && get(
      /databases/$(database)/documents/adminAccess/$(request.auth.uid)
      ).data.active == true;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.admin == true
        && hasActiveAdminAccess();
    }

    match /adminAccess/{userId} {
      allow read, write: if false;
    }

    // Staff identity, invitation, designation, permission and audit records are
    // server-managed. Privileged APIs enforce the trusted administrator record.
    match /staffPermissionAdministrators/{userId} {
      allow read, write: if false;
    }
    match /staffDirectory/{userId} {
      allow read, write: if false;
    }
    match /staffInvitations/{invitationId} {
      allow read, write: if false;
    }
    match /staffManagementAudit/{auditId} {
      allow read, write: if false;
    }
    match /staffActionPermissionGrants/{grantId} {
      allow read, write: if false;
    }
    match /staffActionPermissions/{userId} {
      allow read, write: if false;
      match /permissions/{permissionId} {
        allow read, write: if false;
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /operationalCostDefinitions/{definitionId} {
      allow read, write: if false;

      match /versions/{versionId} {
        allow read, write: if false;
      }
    }

    match /pudoLocations/{locationId} {
      allow read, write: if false;

      match /auditEvents/{eventId} {
        allow read, write: if false;
      }
    }

    match /pudoLocationVerifications/{locationId} {
      allow read, write: if false;

      match /inspectionRecords/{inspectionId} {
        allow read, write: if false;
      }

      match /auditEvents/{eventId} {
        allow read, write: if false;
      }
    }

    match /commercialPricingDefinitions/{definitionId} {
      allow read, write: if false;

      match /versions/{versionId} {
        allow read, write: if false;
      }
    }
  }
}
